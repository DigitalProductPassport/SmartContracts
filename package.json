{
  "name": "@digitalproductpassport/smartcontracts",
  "version": "1.0.23",
  "description": "Public project for Digital Product Passport with the idea to create an EIP",
  "main": "index.js",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "gas": "hardhat test --gas-stats",
    "prepublishOnly": "hardhat build",
    "deploy:local": "hardhat ignition deploy ignition/modules/DigitalProductPassport.ts",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/DigitalProductPassport.ts --network sepolia --verify",
    "prettier:check": "prettier --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "security:slither": "slither contracts --solc-remaps '@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/ @openzeppelin/contracts-upgradeable/=node_modules/@openzeppelin/contracts-upgradeable/' --json slither-report.json",
    "security:mythril": "mkdir -p reports && find contracts -name \"*.sol\" -print0 | xargs -0 -I{} myth analyze {} --solv 0.8.37 -o json --solc-json remappings.json",
    "security:mythril-single": "myth analyze contracts/ProductPassport.sol --solv 0.8.37 -o json --solc-json remappings.json --solc-args=\"--allow-paths . --base-path . --include-path node_modules\"",
    "security:all": "npm run security:slither && npm run security:mythril-single"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.3",
    "@nomicfoundation/ignition-core": "^3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "~5.9.3"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalProductPassport/SmartContracts.git"
  },
  "keywords": [
    "ethereum",
    "smart contracts",
    "EIP",
    "Digital Product Passport"
  ],
  "homepage": "https://github.com/DigitalProductPassport/SmartContracts",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  }
}
